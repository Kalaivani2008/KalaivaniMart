<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Stationery Mart</display-name>


    <!-- ========================= -->
    <!-- HikariCP DataSource -->
    <!-- ========================= -->

    <listener>
        <listener-class>
            com.kalaivani.mart.listener.DataSourceListener
        </listener-class>
    </listener>


    <!-- ========================= -->
    <!-- Database Initializer -->
    <!-- ========================= -->

    <listener>
        <listener-class>
            com.kalaivani.mart.listener.DatabaseInitializer
        </listener-class>
    </listener>


    <!-- ========================= -->
    <!-- Encoding Filter -->
    <!-- ========================= -->

    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>
            com.kalaivani.mart.filter.EncodingFilter
        </filter-class>
    </filter>

    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>


    <!-- ========================= -->
    <!-- Authentication Filter -->
    <!-- ========================= -->

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>
            com.kalaivani.mart.filter.AuthFilter
        </filter-class>
    </filter>


    <!-- Seller pages -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/seller/*</url-pattern>
    </filter-mapping>


    <!-- Admin pages -->
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>


    <!-- ========================= -->
    <!-- Session Configuration -->
    <!-- ========================= -->

    <session-config>
        <session-timeout>30</session-timeout>

        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

</web-app>